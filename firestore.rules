rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownLinkPath() {
      return /databases/$(database)/documents/auth_links/$(request.auth.uid);
    }

    function hasOwnLink() {
      return signedIn() && exists(ownLinkPath());
    }

    function ownLink() {
      return get(ownLinkPath()).data;
    }

    function isActive() {
      return hasOwnLink() && ownLink().active != false;
    }

    function currentUserPath() {
      return /databases/$(database)/documents/users/$(ownLink().user_id);
    }

    function isTiMaster() {
      return isActive()
        && exists(currentUserPath())
        && ('sectors' in get(currentUserPath()).data)
        && get(currentUserPath()).data.sectors.hasAny(['ti']);
    }

    function isAdmin() {
      return isActive()
        && (ownLink().role == 'admin' || isTiMaster());
    }

    function currentUserId() {
      return ownLink().user_id;
    }

    function canManageBacklog() {
      return isActive() && exists(currentUserPath())
        && get(currentUserPath()).data.active != false
        && get(currentUserPath()).data.username in ['ryan', 'japan-ti'];
    }

    match /auth_links/{uid} {
      allow read: if isActive()
        && (request.auth.uid == uid || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isActive();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (
          isActive()
          && currentUserId() == userId
          && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly(['name', 'avatar', 'backgroundColor', 'updated_at'])
        );
    }

    match /user_feature_permissions/{docId} {
      allow read: if isActive();
      allow write: if isAdmin();
    }

    match /user_tab_permissions/{docId} {
      allow read: if isActive();
      allow write: if isAdmin();
    }

    match /task_permissions/{docId} {
      allow read: if isActive();
      allow write: if isAdmin();
    }

    match /app_settings/{docId} {
      allow read: if isActive();
      // Apenas o texto do rodapé pode ser alterado pela equipe autorizada à GAS.
      allow create, update: if docId == 'system_footer'
        && canReadGas()
        && request.resource.data.keys().hasOnly(['message', 'updated_at'])
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 180;
      allow create, update: if docId != 'system_footer' && isAdmin();
      allow delete: if docId != 'system_footer' && isAdmin();
    }

    match /freight_destinations/{docId} {
      allow read: if isActive();
      allow write: if isAdmin();
    }

    match /system_notifications/{notificationId} {
      allow read: if isActive()
        && resource.data.recipient_user_id == currentUserId();
      allow update: if isActive()
        && resource.data.recipient_user_id == currentUserId()
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly(['read']);
      allow create, delete: if false;
    }

    match /system_runtime/{docId} {
      allow read: if isActive();
      allow create, update, delete: if false;
    }

    // Histórico agregado do monitor: somente leitura por administradores/TI.
    // Gravações são exclusivas do backend com credenciais de serviço.
    function canReadGas() {
      return isActive() && exists(currentUserPath())
        && get(currentUserPath()).data.active != false
        && (
          get(currentUserPath()).data.username in ['ryan', 'joe_', 'japan-ti']
          || isTiMaster()
        );
    }

    match /system_usage_daily/{day} {
      allow read: if canReadGas();
      allow create, update, delete: if false;
    }

    match /system_monitor_state/{docId} {
      allow read, write: if false;
    }

    // Mensagens privadas: apenas remetente e destinatário.
    match /messages/{messageId} {
      function participant(data) {
        return isActive()
          && (
            data.senderId == currentUserId()
            || data.receiverId == currentUserId()
          );
      }

      allow get: if participant(resource.data);
      allow list: if participant(resource.data);
      allow create: if isActive()
        && request.resource.data.senderId == currentUserId()
        && request.resource.data.receiverId is string
        && request.resource.data.receiverId != currentUserId()
        && request.resource.data.content is string;
      // Texto enviado é imutável. Autor pode somente apagar logicamente,
      // destinatário pode somente marcar como lida.
      allow update: if participant(resource.data)
        && request.resource.data.senderId == resource.data.senderId
        && request.resource.data.receiverId == resource.data.receiverId
        && (
          (
            resource.data.senderId == currentUserId()
            && resource.data.get('deleted', false) != true
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted', 'content'])
            && request.resource.data.deleted == true
            && request.resource.data.content == 'Mensagem apagada'
          )
          ||
          (
            // Cada participante altera apenas sua reação; o conteúdo segue imutável.
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
            && request.resource.data.get('reactions', {}) is map
            && resource.data.get('reactions', {}) is map
            && request.resource.data.reactions.diff(resource.data.get('reactions', {}))
              .affectedKeys().hasOnly([currentUserId()])
            && (
              !(currentUserId() in request.resource.data.reactions)
              || request.resource.data.reactions[currentUserId()] in ['👍', '❤️', '😂', '😮', '🙏', '🔥']
            )
          )
          ||
          (
            resource.data.receiverId == currentUserId()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'read_at'])
            && resource.data.get('read', false) == false
            && request.resource.data.read == true
            && request.resource.data.read_at == request.time
          )
        );
      allow delete: if false;
    }

    // Autorização dos grupos.
    function groupPath(groupId) {
      return /databases/$(database)/documents/custom_groups/$(groupId);
    }

    function isGroupMember(groupId) {
      return isActive()
        && exists(groupPath(groupId))
        && currentUserId() in get(groupPath(groupId)).data.participant_ids;
    }

    function isGroupCreator(groupId) {
      return isGroupMember(groupId)
        && get(groupPath(groupId)).data.created_by == currentUserId();
    }

    match /custom_groups/{groupId} {
      allow get: if isGroupMember(groupId);
      allow list: if isActive()
        && currentUserId() in resource.data.participant_ids;
      allow create: if isActive()
        && request.resource.data.created_by == currentUserId()
        && request.resource.data.participant_ids is list
        && currentUserId() in request.resource.data.participant_ids
        && request.resource.data.participant_ids.size() > 0
        && request.resource.data.participant_ids.size() <= 100
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0;
      allow update: if false;
      allow delete: if isGroupCreator(groupId);
    }

    match /group_messages/{messageId} {
      allow get: if isGroupMember(resource.data.group_id);
      allow list: if isGroupMember(resource.data.group_id);
      allow create: if isActive()
        && request.resource.data.group_id is string
        && isGroupMember(request.resource.data.group_id)
        && request.resource.data.sender_id == currentUserId()
        && request.resource.data.sender_username == get(currentUserPath()).data.username
        && request.resource.data.content is string
        && request.resource.data.deleted == false
        && request.resource.data.edited == false;
      // Somente exclusão lógica, nunca edição de mensagem.
      allow update: if isGroupMember(resource.data.group_id)
        && resource.data.sender_id == currentUserId()
        && resource.data.deleted == false
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['content', 'deleted', 'updated_at'])
        && request.resource.data.sender_id == resource.data.sender_id
        && request.resource.data.group_id == resource.data.group_id
        && request.resource.data.sender_username == resource.data.sender_username
        && request.resource.data.deleted == true
        && request.resource.data.content == 'Mensagem apagada';
      allow delete: if false;
    }

    // Compatibilidade com status de leitura de chats privados e grupos.
    match /chat_read_status/{statusId} {
      function groupStatus(data) {
        return 'user_id' in data
          && data.user_id == currentUserId()
          && 'group_id' in data
          && data.group_id is string
          && isGroupMember(data.group_id);
      }

      function privateStatus(data) {
        return 'userId' in data
          && data.userId == currentUserId()
          && 'partnerId' in data
          && data.partnerId is string;
      }

      allow get: if isActive()
        && (groupStatus(resource.data) || privateStatus(resource.data));

      // A consulta do useGroupUnread filtra por user_id, sem group_id.
      // Limitar a registros do proprio usuario evita depender da adesao
      // ao grupo como filtro de uma consulta de colecao.
      allow list: if isActive()
        && request.query.limit <= 100
        && resource.data.user_id == currentUserId();

      allow create: if isActive()
        && (groupStatus(request.resource.data) || privateStatus(request.resource.data));

      allow update: if isActive()
        && (
          (
            groupStatus(resource.data)
            && groupStatus(request.resource.data)
            && request.resource.data.group_id == resource.data.group_id
            && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly(['last_read_at', 'updated_at'])
          )
          ||
          (
            privateStatus(resource.data)
            && privateStatus(request.resource.data)
            && request.resource.data.userId == resource.data.userId
            && request.resource.data.partnerId == resource.data.partnerId
            && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly(['username', 'partner_username', 'last_read_at', 'updated_at'])
          )
        );
      allow delete: if false;
    }

    // Criar uma tarefa vinculada exige que o funcionário seja o autor da
    // garantia manual existente. O frontend cria ficha e tarefa em duas operações,
    // NÃO no mesmo batch. A Cloud Function usa Admin SDK para tarefas do site.
    function mayCreateLinkedWarrantyTask() {
      let claimId = request.resource.data.get('warranty_id', '');
      let claimPath = /databases/$(database)/documents/warranty_claims/$(claimId);
      return canSeeWarrantyModule()
        && claimId is string
        && claimId.matches('^[A-Za-z0-9_-]{1,180}$')
        && request.resource.data.get('created_by', '') == currentUserId()
        && request.resource.data.get('sector', '') == 'garantias'
        && request.resource.data.get('board_visible', false) == true
        && request.resource.data.get('assignee_id', '') == 'emp-12'
        && request.resource.data.get('status', '') == 'todo'
        && request.resource.data.get('priority', '') == 'high'
        && !request.resource.data.keys().hasAny([
          'archived_at', 'archived_by', 'archivedAt', 'archivedBy',
          'warranty_archived_by_deletion', 'warranty_previous_board_visible'
        ])
        && exists(claimPath)
        && get(claimPath).data.get('requested_by', '') == currentUserId()
        && get(claimPath).data.get('origin', 'manual') != 'site'
        && get(claimPath).data.get('deleted_at', null) == null;
    }

    // Operational tasks: active staff may update status; transfer is forbidden to motoboys.
    match /tasks/{taskId} {
      allow read: if isActive();
      allow create: if isActive() && (
        request.resource.data.get('warranty_id', '') == ''
        || mayCreateLinkedWarrantyTask()
      );
      // Tarefas ligadas a garantia não podem ser excluídas diretamente.
      allow delete: if isActive() && resource.data.get('warranty_id', '') == '';
      allow update: if isActive()
        && request.resource.data.get('warranty_id', '') == resource.data.get('warranty_id', '')
        && (resource.data.get('warranty_id', '') == ''
          || !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'archived_at', 'archived_by', 'archivedAt', 'archivedBy',
            'board_visible', 'warranty_archived_by_deletion', 'warranty_previous_board_visible'
          ]))
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['assignee_id', 'assignee_ids', 'assigneeId'])
          || (
            isAdmin()
            || (
              exists(currentUserPath())
              && get(currentUserPath()).data.active != false
              && !(('sectors' in get(currentUserPath()).data) && get(currentUserPath()).data.sectors.hasAny(['motoboys']))
            )
          )
        );
    }

    // Comunicados exclusivos do Ryan, com acesso validado no Firestore.
    function isRyan() {
      return isActive() && exists(currentUserPath())
        && get(currentUserPath()).data.username == 'ryan';
    }

    match /ryan_announcements/{announcementId} {
      allow read: if isActive();
      allow create: if isRyan()
        && request.resource.data.created_by == currentUserId()
        && request.resource.data.keys().hasOnly(['title','body','created_by','created_at','image_urls','media_types','batch_id','batch_order'])
        && request.resource.data.image_urls is list
        && request.resource.data.image_urls.size() <= 5
        && request.resource.data.media_types is list
        && request.resource.data.media_types.size() == request.resource.data.image_urls.size()
        && request.resource.data.media_types.hasOnly(['image', 'video'])
        && request.resource.data.batch_id is string
        && request.resource.data.batch_order is int
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 120
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 3000;
      allow update, delete: if false;
    }

    match /ryan_announcement_acks/{ackId} {
      allow read: if isActive();
      allow create: if isActive()
        && request.resource.data.user_id == currentUserId()
        && request.resource.data.announcement_id is string
        && ackId == request.resource.data.announcement_id + '_' + currentUserId();
      allow update, delete: if false;
    }

    // Resposta privada ao autor do reporte, com confirmação de leitura por emoji.
    match /backlog_responses/{reportId} {
      allow read: if canManageBacklog()
        || (isActive() && resource.data.recipient_id == currentUserId());
      allow create: if canManageBacklog()
        && request.resource.data.keys().hasOnly([
          'report_id', 'recipient_id', 'author_id', 'body', 'created_at', 'reaction', 'reacted_at'
        ])
        && request.resource.data.report_id == reportId
        && exists(/databases/$(database)/documents/user_problem_reports/$(reportId))
        && request.resource.data.recipient_id == get(/databases/$(database)/documents/user_problem_reports/$(reportId)).data.user_id
        && request.resource.data.author_id == currentUserId()
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 2
        && request.resource.data.body.size() <= 2000
        && request.resource.data.reaction == null
        && request.resource.data.reacted_at == null;
      allow update: if isActive()
        && resource.data.recipient_id == currentUserId()
        && resource.data.reaction == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reaction', 'reacted_at'])
        && request.resource.data.reaction in ['👍', '❤️', '🙏', '✅', '😊']
        && request.resource.data.reacted_at == request.time;
      allow delete: if false;
    }

    match /user_problem_reports/{reportId} {
      allow create: if isActive()
        && request.resource.data.user_id == currentUserId()
        && request.resource.data.status == 'new'
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 10
        && request.resource.data.description.size() <= 2500
        && request.resource.data.archived == false
        && request.resource.data.image_urls is list
        && request.resource.data.image_urls.size() <= 5;
      allow read: if canManageBacklog() || (isActive() && resource.data.user_id == currentUserId());
      allow update: if canManageBacklog()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','archived','updated_at','updated_by'])
        && request.resource.data.status in ['new','in_progress','resolved']
        && request.resource.data.archived is bool
        && (request.resource.data.status != 'resolved' || request.resource.data.archived == true)
        && request.resource.data.archived is bool
        && (request.resource.data.status != 'resolved' || request.resource.data.archived == true)
        && request.resource.data.updated_by == currentUserId();
      allow delete: if false;
    }

    // Only Admin SDK may change intake receipts/quota/leases.
    // Todas as operações de lixeira e tarefas relacionadas são feitas pela
    // Cloud Function autenticada, nunca diretamente pelo navegador.
    function warrantyFeatureEnabled() {
      let permissionId = 'tracking_warranties__' + currentUserId();
      let perm = /databases/$(database)/documents/user_feature_permissions/$(permissionId);
      return exists(perm) && get(perm).data.get('enabled', false) == true
        && get(perm).data.get('user_id', '') == currentUserId()
        && get(perm).data.get('feature_key', '') == 'tracking_warranties';
    }

    function canSeeWarrantyModule() {
      return isActive() && exists(currentUserPath())
        && get(currentUserPath()).data.get('active', true) != false
        && (isAdmin()
          || get(currentUserPath()).data.get('sectors', []).hasAny([
            'garantias', 'vendas', 'expedicao', 'site'
          ])
          || warrantyFeatureEnabled());
    }

    match /warranty_claims/{claimId} {
      allow read: if isActive();
      allow create: if canSeeWarrantyModule()
        && !claimId.matches('^site_.*')
        && request.resource.data.get('requested_by', '') == currentUserId()
        && request.resource.data.get('origin', '') != 'site'
        && !request.resource.data.keys().hasAny(['deleted_at', 'deleted_by']);
      // Permite campos normais de edição e status. Marcadores imutáveis e
      // dados de lixeira não podem ser escritos por nenhum cliente.
      allow update: if canSeeWarrantyModule()
        && resource.data.get('deleted_at', null) == null
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'requested_by', 'origin', 'created_at', 'site_protocol',
          'site_attachments', 'deleted_at', 'deleted_by'
        ]);
      allow delete: if false;
    }

    // As notas do cliente podem ser criadas pela interface; os eventos de
    // lixeira continuam exclusivos da Cloud Function/ Admin SDK.
    function mayCreateWarrantyNote() {
      let claimId = request.resource.data.get('warranty_id', '');
      let claimPath = /databases/$(database)/documents/warranty_claims/$(claimId);
      return canSeeWarrantyModule()
        && request.resource.data.keys().hasOnly([
          'warranty_id', 'user_id', 'content', 'attachment_url',
          'attachment_name', 'created_at'
        ])
        && request.resource.data.get('user_id', '') == currentUserId()
        && claimId is string
        && claimId.matches('^[A-Za-z0-9_-]{1,180}$')
        && request.resource.data.get('content', '') is string
        && request.resource.data.get('created_at', null) is timestamp
        && request.resource.data.get('content', '') != 'Garantia enviada para a lixeira.'
        && request.resource.data.get('content', '') != 'Garantia restaurada da lixeira.'
        && exists(claimPath)
        && get(claimPath).data.get('deleted_at', null) == null;
    }

    match /warranty_updates/{updateId} {
      allow read: if isActive();
      allow create: if mayCreateWarrantyNote();
      allow update, delete: if false;
    }

    match /site_warranty_receipts/{receiptId} {
      allow read, write: if false;
    }

    // GPS de corrida: o proprio motoboy inicia o compartilhamento de modo opt-in.
    // O gestor ve apenas a ultima posicao. Nenhum historico de trajeto e armazenado.
    function canViewMotoboyGps() {
      return isAdmin() || (isActive() && currentUserId() == 'emp-1');
    }

    function ownsActiveRide(rideId) {
      return isActive()
        && exists(/databases/$(database)/documents/motoboy_assignments/$(rideId))
        && get(/databases/$(database)/documents/motoboy_assignments/$(rideId)).data.assigned_to == currentUserId()
        && get(/databases/$(database)/documents/motoboy_assignments/$(rideId)).data.status == 'accepted';
    }

    function validLiveGps(rideId) {
      return request.resource.data.keys().hasOnly(['ride_id','user_id','lat','lng','accuracy','updated_at'])
        && request.resource.data.keys().hasAll(['ride_id','user_id','lat','lng','accuracy','updated_at'])
        && request.resource.data.ride_id == rideId
        && request.resource.data.user_id == currentUserId()
        && request.resource.data.lat is number
        && request.resource.data.lng is number
        && request.resource.data.accuracy is number
        && request.resource.data.lat >= -90 && request.resource.data.lat <= 90
        && request.resource.data.lng >= -180 && request.resource.data.lng <= 180
        && request.resource.data.accuracy >= 0 && request.resource.data.accuracy <= 100000
        && request.resource.data.updated_at == request.time;
    }

    match /motoboy_live_locations/{rideId} {
      allow get, list: if canViewMotoboyGps();
      allow create: if ownsActiveRide(rideId) && validLiveGps(rideId);
      allow update: if ownsActiveRide(rideId)
        && resource.data.user_id == currentUserId()
        && validLiveGps(rideId);
      allow delete: if isActive() && (resource.data.user_id == currentUserId() || canViewMotoboyGps());
    }

    function motoboyOwnSession(userId) {
      return isActive() && currentUserId() == userId
        && exists(currentUserPath())
        && get(currentUserPath()).data.sectors.hasAny(['motoboys']);
    }

    function validMotoboySession(userId) {
      return request.resource.data.keys().hasOnly(['user_id','phase','lat','lng','accuracy','updated_at'])
        && request.resource.data.keys().hasAll(['user_id','phase','updated_at'])
        && request.resource.data.user_id == userId
        && request.resource.data.phase in ['delivering','returning']
        && request.resource.data.updated_at == request.time
        && (!('lat' in request.resource.data) ||
          (request.resource.data.lat is number && request.resource.data.lat >= -90 && request.resource.data.lat <= 90))
        && (!('lng' in request.resource.data) ||
          (request.resource.data.lng is number && request.resource.data.lng >= -180 && request.resource.data.lng <= 180))
        && (!('accuracy' in request.resource.data) ||
          (request.resource.data.accuracy is number && request.resource.data.accuracy >= 0 && request.resource.data.accuracy <= 100000));
    }

    match /motoboy_live_sessions/{userId} {
      allow get: if motoboyOwnSession(userId) || canViewMotoboyGps();
      allow list: if canViewMotoboyGps();
      allow create, update: if motoboyOwnSession(userId) && validMotoboySession(userId);
      allow delete: if motoboyOwnSession(userId) || canViewMotoboyGps();
    }

    function canUseSalesReferences() {
      return isActive() && exists(currentUserPath())
        && get(currentUserPath()).data.active != false
        && ('sectors' in get(currentUserPath()).data)
        && get(currentUserPath()).data.sectors.hasAny(['vendas']);
    }

    match /part_references/{referenceId} {
      allow get, list: if canUseSalesReferences();
      allow create: if canUseSalesReferences()
        && request.resource.data.keys().hasOnly(['name','description','vehicle_brand','vehicles','manufacturer','part_type','year_start','year_end','photos','created_by','created_at','updated_at'])
        && request.resource.data.keys().hasAll(['name','description','vehicle_brand','vehicles','manufacturer','part_type','year_start','year_end','photos','created_by','created_at','updated_at'])
        && request.resource.data.created_by == currentUserId()
        && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 140
        && request.resource.data.description is string && request.resource.data.description.size() <= 3000
        && request.resource.data.part_type is string && request.resource.data.part_type.size() >= 1 && request.resource.data.part_type.size() <= 100
        && request.resource.data.manufacturer is string && request.resource.data.manufacturer.size() >= 1 && request.resource.data.manufacturer.size() <= 120
        && request.resource.data.vehicle_brand in ['Mitsubishi','Toyota','Honda','Suzuki','Subaru']
        && request.resource.data.vehicles is list && request.resource.data.vehicles.size() >= 1 && request.resource.data.vehicles.size() <= 30
        && request.resource.data.year_start is int && request.resource.data.year_end is int
        && request.resource.data.year_start >= 1950 && request.resource.data.year_start <= request.resource.data.year_end && request.resource.data.year_end <= 2100
        && request.resource.data.photos is list && request.resource.data.photos.size() >= 1 && request.resource.data.photos.size() <= 6
        && request.resource.data.created_at == request.time && request.resource.data.updated_at == request.time;
      allow update, delete: if false;
    }

    // Pontos do percurso: somente motoboy da corrida ativa cria amostras.
    // Os campos "meters" enviados pelo dispositivo nao sao usados no calculo do fechamento.
    function validTelemetry() {
      let r = request.resource.data;
      let ridePath = /databases/$(database)/documents/motoboy_assignments/$(r.ride_id);
      return isActive() && exists(currentUserPath())
        && get(currentUserPath()).data.sectors.hasAny(['motoboys'])
        && r.keys().hasOnly(['user_id','ride_id','day','lat','lng','accuracy','client_at','meters','recorded_at'])
        && r.keys().hasAll(['user_id','ride_id','day','lat','lng','accuracy','client_at','meters','recorded_at'])
        && r.user_id == currentUserId()
        && r.ride_id is string && r.day is string && r.day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && r.lat is number && r.lat >= -90 && r.lat <= 90
        && r.lng is number && r.lng >= -180 && r.lng <= 180
        && r.accuracy is number && r.accuracy >= 0 && r.accuracy <= 50
        && r.client_at is number && r.meters is number && r.meters >= 0 && r.meters <= 1000
        && r.recorded_at == request.time
        && exists(ridePath)
        && get(ridePath).data.assigned_to == currentUserId()
        && get(ridePath).data.status == 'accepted';
    }
    match /motoboy_telemetry/{sampleId} {
      allow get, list: if canViewMotoboyGps();
      allow create: if validTelemetry();
      allow update, delete: if false;
    }
    match /motoboy_daily_reports/{day} {
      allow get, list: if canViewMotoboyGps();
      allow create, update, delete: if false;
    }

    // Colecoes operacionais nao cobertas pelas regras especificas.
    match /{collection}/{document=**} {
      allow read, write: if isActive()
        && collection != 'site_warranty_receipts'
        && collection != 'warranty_claims'
        && collection != 'warranty_updates'
        && collection != 'users'
        && collection != 'auth_links'
        && collection != 'user_feature_permissions'
        && collection != 'user_tab_permissions'
        && collection != 'task_permissions'
        && collection != 'app_settings'
        && collection != 'custom_groups'
        && collection != 'group_messages'
        && collection != 'chat_read_status'
        && collection != 'freight_destinations'
        && collection != 'system_notifications'
        && collection != 'system_usage_daily'
        && collection != 'system_runtime'
        && collection != 'system_monitor_state'
        && collection != 'messages'
        && collection != 'motoboy_live_locations'
        && collection != 'motoboy_live_sessions'
        && collection != 'motoboy_telemetry'
        && collection != 'motoboy_daily_reports'
        && collection != 'part_references'
        && collection != 'tasks'
        && collection != 'ryan_announcements'
        && collection != 'ryan_announcement_acks'
        && collection != 'user_problem_reports'
        && collection != 'backlog_responses';
    }
  }
}