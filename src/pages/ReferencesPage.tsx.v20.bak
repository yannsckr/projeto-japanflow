import { useEffect, useMemo, useState } from 'react';
import { collection, addDoc, getDocs, limit, query, startAfter, where, type QueryDocumentSnapshot, type DocumentData, serverTimestamp } from 'firebase/firestore';
import { getDownloadURL, ref, uploadBytes, deleteObject } from 'firebase/storage';
import { ArrowLeft, Cog, Filter, ImagePlus, Plus, Search, SlidersHorizontal, X } from 'lucide-react';
import { toast } from 'sonner';
import { db, storage } from '@/lib/firebase';
import { useApp } from '@/contexts/AppContext';
import { Button } from '@/components/ui/button';
import { Input } from '@/components/ui/input';

const BRANDS = ['Mitsubishi', 'Toyota', 'Honda', 'Suzuki', 'Subaru'] as const;
type Brand = (typeof BRANDS)[number];
type Reference = { id: string; name: string; description: string; vehicleBrand: Brand; vehicles: string[]; manufacturer: string; partType: string; yearStart: number; yearEnd: number; photos: string[] };
const PAGE_SIZE = 24;
const blank = { name:'', description:'', manufacturer:'', partType:'', vehicles:'', yearStart:'2000', yearEnd:String(new Date().getFullYear()) };

const clean = (x: unknown) => String(x ?? '').trim();

export default function ReferencesPage() {
  const { currentUser } = useApp();
  const allowed = Boolean(currentUser?.active !== false && currentUser?.sectors?.includes('vendas'));
  const [brand, setBrand] = useState<Brand | null>(null);
  const [items, setItems] = useState<Reference[]>([]);
  const [cursor, setCursor] = useState<QueryDocumentSnapshot<DocumentData> | null>(null);
  const [hasMore, setHasMore] = useState(false);
  const [loading, setLoading] = useState(false);
  const [search, setSearch] = useState('');
  const [filterOpen, setFilterOpen] = useState(false);
  const [partFilter, setPartFilter] = useState('');
  const [vehicleFilter, setVehicleFilter] = useState('');
  const [createOpen, setCreateOpen] = useState(false);
  const [form, setForm] = useState(blank);
  const [files, setFiles] = useState<File[]>([]);
  const [saving, setSaving] = useState(false);
  const [error, setError] = useState('');
  const [reload, setReload] = useState(0);
  const [imageIndex, setImageIndex] = useState<Record<string, number>>({});
  const [globalItems, setGlobalItems] = useState<Reference[]>([]);
  const [searched, setSearched] = useState(false);
  const [globalLoading, setGlobalLoading] = useState(false);
  const [globalError, setGlobalError] = useState('');
  const [globalBrand, setGlobalBrand] = useState('');
  const [selected, setSelected] = useState<string | null>(null);
  const [deletingId, setDeletingId] = useState<string | null>(null);
  const [incomplete, setIncomplete] = useState(false);


  useEffect(() => {
    setItems([]); setCursor(null); setHasMore(false); setError(''); setSelected(null);
    if (!brand || !allowed) return;
    let cancelled = false;
    setLoading(true);
    void getDocs(query(collection(db, 'part_references'), where('vehicle_brand', '==', brand), limit(PAGE_SIZE)))
      .then(snapshot => {
        if (cancelled) return;
        setItems(snapshot.docs.map(d => ({ id:d.id, name:clean(d.data().name), description:clean(d.data().description), vehicleBrand:brand, vehicles:Array.isArray(d.data().vehicles)?d.data().vehicles.map(String):[], manufacturer:clean(d.data().manufacturer), partType:clean(d.data().part_type), yearStart:Number(d.data().year_start), yearEnd:Number(d.data().year_end), photos:Array.isArray(d.data().photos)?d.data().photos.map(String):[] })));
        setCursor(snapshot.docs[snapshot.docs.length - 1] ?? null);
        setHasMore(snapshot.docs.length === PAGE_SIZE);
      }).catch(e => { if (!cancelled) { console.error(e); setError('Não foi possível carregar as peças desta marca.'); } })
      .finally(() => { if (!cancelled) setLoading(false); });
    return () => { cancelled = true; };
  }, [brand, allowed, reload]);

  const loadMore = async () => {
    if (!brand || !cursor || loading || !hasMore) return;
    setLoading(true);
    try {
      const snapshot = await getDocs(query(collection(db, 'part_references'), where('vehicle_brand', '==', brand), startAfter(cursor), limit(PAGE_SIZE)));
      setItems(prev => [...prev, ...snapshot.docs.map(d => ({ id:d.id, name:clean(d.data().name), description:clean(d.data().description), vehicleBrand:brand, vehicles:Array.isArray(d.data().vehicles)?d.data().vehicles.map(String):[], manufacturer:clean(d.data().manufacturer), partType:clean(d.data().part_type), yearStart:Number(d.data().year_start), yearEnd:Number(d.data().year_end), photos:Array.isArray(d.data().photos)?d.data().photos.map(String):[] }))]);
      setCursor(snapshot.docs[snapshot.docs.length - 1] ?? null);
      setHasMore(snapshot.docs.length === PAGE_SIZE);
    } catch(e) { console.error(e); toast.error('Não foi possível carregar mais peças.'); }
    finally { setLoading(false); }
  };
  const types = useMemo(() => [...new Set((brand ? items : globalItems).map(i => i.partType).filter(Boolean))].sort(), [items, globalItems, brand]);
  const visible = useMemo(() => (brand ? items : globalItems).filter(i =>
    (!search.trim() || [i.name,i.description,i.manufacturer,i.partType,i.vehicleBrand,...i.vehicles].join(' ').toLowerCase().includes(search.trim().toLowerCase())) &&
    (!globalBrand || i.vehicleBrand===globalBrand) &&
    (!partFilter || i.partType===partFilter) &&
    (!vehicleFilter || i.vehicles.some(v=>v.toLowerCase().includes(vehicleFilter.toLowerCase())))
  ), [items, globalItems, brand, search, globalBrand, partFilter, vehicleFilter]);
  const selectedItem = visible.find(i=>i.id===selected) || null;

  const searchGlobal = async () => {
    if (globalLoading) return;
    setGlobalLoading(true); setGlobalError(''); setIncomplete(false); setSearched(true); setGlobalItems([]);
    try {
      const result: Reference[]=[];
      let last: QueryDocumentSnapshot<DocumentData> | null=null;
      // Busca global sob demanda, sem antecipar leitura de todas as peças na home.
      // Limite defensivo para evitar leituras excessivas: registrar incompletude quando atingido.
      while (result.length < 3000) {
        const q = last ? query(collection(db,'part_references'),orderBy(documentId()),startAfter(last),limit(100)) : query(collection(db,'part_references'),orderBy(documentId()),limit(100));
        const snapshot = await getDocs(q);
        result.push(...snapshot.docs.map(d=>({id:d.id,name:clean(d.data().name),description:clean(d.data().description),vehicleBrand:d.data().vehicle_brand as Brand,vehicles:Array.isArray(d.data().vehicles)?d.data().vehicles.map(String):[],manufacturer:clean(d.data().manufacturer),partType:clean(d.data().part_type),yearStart:Number(d.data().year_start),yearEnd:Number(d.data().year_end),photos:Array.isArray(d.data().photos)?d.data().photos.map(String):[]})));
        if (snapshot.docs.length < 100) break;
        last=snapshot.docs[snapshot.docs.length-1];
      }
      setIncomplete(result.length >= 3000); setGlobalItems(result);
    } catch(e){console.error(e);setGlobalError('Não foi possível consultar o catálogo global.');}
    finally{setGlobalLoading(false);}
  };

  const deletePiece = async (item:Reference) => {
    if (deletingId || !window.confirm(`Excluir a peça “${item.name}”? Esta ação não pode ser desfeita.`)) return;
    setDeletingId(item.id);
    try {
      // Deletar primeiro o documento evita que a peça continue visível se a foto falhar.
      await deleteDoc(doc(db,'part_references',item.id));
      const results=await Promise.allSettled(item.photos.filter(p=>p.startsWith('sales_references/')).map(p=>deleteObject(ref(storage,p))));
      setItems(old=>old.filter(i=>i.id!==item.id)); setGlobalItems(old=>old.filter(i=>i.id!==item.id));
      setSelected(null);
      if(results.some(x=>x.status==='rejected')) toast.warning('Peça excluída, mas algumas fotos precisam de limpeza.');
      else toast.success('Peça excluída.');
    }catch(e){console.error(e);toast.error('Não foi possível excluir. Verifique as permissões.');}
    finally{setDeletingId(null);}
  };


  const save = async () => {
    if (!brand || !currentUser || saving) return;
    const years = [Number(form.yearStart),Number(form.yearEnd)];
    const vehicles = form.vehicles.split(/[\n,;]+/).map(x=>x.trim()).filter(Boolean);
    if (!form.name.trim() || !form.partType.trim() || !form.manufacturer.trim() || vehicles.length===0 || files.length===0 || years.some(n=>!Number.isInteger(n)) || years[0]<1950 || years[1]>2100 || years[0]>years[1]) {
      toast.error('Preencha nome, tipo, fabricante, carros, anos válidos e ao menos uma foto.'); return;
    }
    if (files.length > 6 || files.some(f=>!['image/jpeg','image/png','image/webp'].includes(f.type) || f.size>8*1024*1024)) { toast.error('Até 6 imagens JPG/PNG/WebP com até 8 MB cada.'); return; }
    setSaving(true);
    try {
      const paths:string[]=[];
      for (const [i,file] of files.entries()) {
        const extension = file.type==='image/png'?'png':file.type==='image/webp'?'webp':'jpg';
        const path=`sales_references/${currentUser.id}/${crypto.randomUUID()}-${i}.${extension}`;
        const target=ref(storage,path);
        await uploadBytes(target,file,{contentType:file.type});
        // As regras do Storage limitam o acesso autenticado ao setor vendas.
        paths.push(path);
      }
      await addDoc(collection(db,'part_references'),{ name:form.name.trim(), description:form.description.trim(), vehicle_brand:brand, vehicles, manufacturer:form.manufacturer.trim(), part_type:form.partType.trim(), year_start:years[0], year_end:years[1], photos:paths, created_by:currentUser.id, created_at:serverTimestamp(), updated_at:serverTimestamp() });
      toast.success('Peça cadastrada!'); setCreateOpen(false); setForm(blank); setFiles([]); setReload(x=>x+1);
    } catch(e) { console.error(e); toast.error('Não foi possível cadastrar a peça. Confira permissões do Firestore e Storage.'); }
    finally { setSaving(false); }
  };

  const [photoUrls,setPhotoUrls]=useState<Record<string,string>>({});
  useEffect(() => {
    if (!allowed) return <div className="rounded-xl border p-6" role="alert">Acesso restrito ao setor de Vendas.</div>;
  const cards = <div className="grid gap-3 sm:grid-cols-2 xl:grid-cols-3">{visible.map(item=>{const index=imageIndex[item.id]??0;const path=item.photos[index];return <article key={item.id} className={`overflow-hidden rounded-xl border bg-card shadow-sm transition ${selected===item.id?'ring-2 ring-primary':''}`}><button type="button" className="relative flex aspect-[4/3] w-full items-center justify-center bg-muted" onClick={()=>setSelected(item.id)} aria-label={`Ver detalhes de ${item.name}`}>{photoUrls[path]?<img src={photoUrls[path]} alt={item.name} className="h-full w-full object-contain"/>:<ImagePlus className="h-10 w-10 text-muted-foreground"/>}</button><div className="space-y-2 p-3"><button type="button" className="text-left font-semibold hover:text-primary" onClick={()=>setSelected(item.id)}>{item.name}</button><p className="line-clamp-2 text-xs text-muted-foreground">{item.description||'Sem descrição'}</p><p className="text-xs text-muted-foreground">{item.vehicleBrand} · {item.partType}</p><div className="flex justify-between gap-2"><Button variant="outline" size="sm" onClick={()=>setSelected(item.id)}>Detalhes</Button><Button variant="ghost" size="sm" disabled={Boolean(deletingId)} onClick={()=>void deletePiece(item)} aria-label={`Excluir ${item.name}`} className="text-destructive"><Trash2 className="h-4 w-4"/></Button></div>{item.photos.length>1&&<div className="flex gap-2">{item.photos.map((p,j)=><button key={p} type="button" className={`h-2.5 w-2.5 rounded-full ${j===index?'bg-primary':'bg-muted-foreground/40'}`} aria-label={`Foto ${j+1}`} onClick={()=>setImageIndex(old=>({...old,[item.id]:j}))}/>)}</div>}</div></article>;})}</div>;
  const filters = <div className="space-y-3"><label className="block text-sm">Tipo de peça<select className="mt-1 w-full rounded-md border bg-background p-2" value={partFilter} onChange={e=>setPartFilter(e.target.value)}><option value="">Todos os tipos</option>{types.map(t=><option key={t} value={t}>{t}</option>)}</select></label><label className="block text-sm">Modelo / carro<Input className="mt-1" placeholder="Ex.: Civic, Lancer..." value={vehicleFilter} onChange={e=>setVehicleFilter(e.target.value)}/></label><Button variant="outline" size="sm" onClick={()=>{setPartFilter('');setVehicleFilter('');setGlobalBrand('');}}>Limpar filtros</Button></div>;
  const details = <div className="space-y-3"><p className="text-sm text-muted-foreground">Selecione um card para ver os dados completos.</p>{selectedItem&&<div className="space-y-2 text-sm"><h3 className="font-semibold text-base">{selectedItem.name}</h3><p>{selectedItem.description}</p><p><strong>Tipo:</strong> {selectedItem.partType}</p><p><strong>Fabricante:</strong> {selectedItem.manufacturer}</p><p><strong>Marca:</strong> {selectedItem.vehicleBrand}</p><p><strong>Modelos:</strong> {selectedItem.vehicles.join(', ')}</p><p><strong>Anos:</strong> {selectedItem.yearStart}–{selectedItem.yearEnd}</p><Button variant="destructive" size="sm" disabled={Boolean(deletingId)} onClick={()=>void deletePiece(selectedItem)}><Trash2 className="mr-2 h-4 w-4"/>Excluir peça</Button></div>}</div>;
  return <div className="mx-auto max-w-7xl space-y-5 pb-8">
    <header className="flex flex-wrap items-center justify-between gap-3"><div><h1 className="text-2xl font-bold">Referências de peças</h1><p className="text-sm text-muted-foreground">Catálogo de imagens e compatibilidade</p></div>{brand&&<Button variant="outline" onClick={()=>{setBrand(null);setSelected(null);setSearch('');setPartFilter('');setVehicleFilter('');}}><ArrowLeft className="mr-2 h-4 w-4"/>Todas as marcas</Button>}</header>
    {!brand?<>
      <form className="flex flex-wrap gap-2 rounded-xl border bg-card p-3" onSubmit={e=>{e.preventDefault();void searchGlobal();}}><div className="relative min-w-[220px] flex-1"><Search className="absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-muted-foreground"/><Input className="pl-9" placeholder="Buscar em todas as marcas..." value={search} onChange={e=>setSearch(e.target.value)}/></div><Button type="submit" disabled={globalLoading}>{globalLoading?'Buscando...':'Buscar no catálogo'}</Button><Button type="button" variant="outline" onClick={()=>setFilterOpen(v=>!v)} aria-expanded={filterOpen}><Filter className="mr-2 h-4 w-4"/>Filtros</Button><Button type="button" variant="outline" onClick={()=>{setSearch('');setPartFilter('');setVehicleFilter('');setGlobalBrand('');setSearched(false);setGlobalItems([]);setSelected(null);}} aria-label="Limpar busca"><X className="h-4 w-4"/></Button></form>
      {filterOpen&&<div className="grid gap-3 rounded-xl border bg-card p-4 md:grid-cols-3"><label className="text-sm">Marca<select className="mt-1 w-full rounded-md border bg-background p-2" value={globalBrand} onChange={e=>setGlobalBrand(e.target.value)}><option value="">Todas</option>{BRANDS.map(b=><option key={b}>{b}</option>)}</select></label>{filters}</div>}
      {!searched?<div className="grid grid-cols-2 gap-3 lg:grid-cols-5">{BRANDS.map(b=><button key={b} onClick={()=>{setBrand(b);setSelected(null);}} className="flex min-h-32 flex-col items-center justify-center gap-2 rounded-xl border bg-card p-3 shadow-sm transition hover:border-primary hover:shadow-md"><img className="h-12 w-20 object-contain" src={`/brands/${b.toLowerCase()}.svg`} alt={`Logo ${b}`}/><span className="font-semibold">{b}</span></button>)}</div>:<><p className="text-sm text-muted-foreground">{globalLoading?'Consultando catálogo...':`${visible.length} resultados na busca global.`} {incomplete?'Limite de 3.000 registros atingido; resultados podem estar incompletos.':''}</p>{globalError&&<p role="alert" className="text-destructive">{globalError}</p>}<div className="grid gap-4 lg:grid-cols-[minmax(0,1fr)_300px]"><div>{cards}</div><aside className="h-fit space-y-3 rounded-xl border bg-card p-4 lg:sticky lg:top-4"><h2 className="font-semibold">Detalhes da peça</h2>{details}</aside></div></>}
    </>:<>
      <div className="flex flex-wrap items-center justify-between gap-3"><div><h2 className="text-xl font-semibold">{brand}</h2><p className="text-xs text-muted-foreground">Peças e aplicações da marca</p></div><Button onClick={()=>setCreateOpen(true)}><Plus className="mr-2 h-4 w-4"/>Adicionar peça</Button></div>
      {error&&<p role="alert" className="text-destructive">{error}</p>}
      <div className="grid gap-4 lg:grid-cols-[minmax(0,1fr)_320px]"><div className="space-y-4">{cards}{!loading&&!error&&visible.length===0&&<p className="rounded-xl border p-6 text-sm text-muted-foreground">Nenhuma peça encontrada.</p>}<div className="flex flex-wrap justify-between gap-2 text-xs text-muted-foreground"><span>{items.length} peças carregadas</span>{hasMore&&<Button variant="outline" size="sm" disabled={loading} onClick={()=>void loadMore()}>{loading?'Carregando...':'Carregar mais'}</Button>}</div></div><aside className="h-fit space-y-5 rounded-xl border bg-card p-4 lg:sticky lg:top-4"><div><h2 className="mb-3 font-semibold">Filtros da marca</h2>{filters}</div><div className="border-t pt-4"><h2 className="mb-3 font-semibold">Resumo e informações</h2>{details}</div></aside></div>
      {createOpen&&<div className="fixed inset-0 z-50 flex items-center justify-center bg-black/60 p-3" role="dialog" aria-modal="true" aria-label="Adicionar peça"><div className="max-h-[92vh] w-full max-w-2xl space-y-4 overflow-auto rounded-2xl bg-background p-5 shadow-xl"><div className="flex items-center justify-between"><h2 className="text-lg font-semibold">Adicionar peça — {brand}</h2><Button variant="ghost" size="icon" onClick={()=>setCreateOpen(false)} aria-label="Fechar"><X className="h-4 w-4"/></Button></div><div className="grid gap-3 sm:grid-cols-2"><label className="text-sm">Nome da peça *<Input value={form.name} onChange={e=>setForm(f=>({...f,name:e.target.value}))}/></label><label className="text-sm">Tipo de peça *<Input placeholder="Ex.: Motor, suspensão" value={form.partType} onChange={e=>setForm(f=>({...f,partType:e.target.value}))}/></label><label className="text-sm sm:col-span-2">Descrição<textarea className="mt-1 min-h-20 w-full rounded-md border bg-background p-2" value={form.description} onChange={e=>setForm(f=>({...f,description:e.target.value}))}/></label><label className="text-sm">Marca / fabricante da peça *<Input value={form.manufacturer} onChange={e=>setForm(f=>({...f,manufacturer:e.target.value}))}/></label><label className="text-sm">Marca do carro<Input value={brand} disabled/></label><label className="text-sm sm:col-span-2">Carros / modelos compatíveis * (separe por vírgula ou linha)<textarea className="mt-1 min-h-20 w-full rounded-md border bg-background p-2" value={form.vehicles} onChange={e=>setForm(f=>({...f,vehicles:e.target.value}))} placeholder="Lancer, ASX, Outlander"/></label><label className="text-sm">Ano inicial *<Input type="number" value={form.yearStart} onChange={e=>setForm(f=>({...f,yearStart:e.target.value}))}/></label><label className="text-sm">Ano final *<Input type="number" value={form.yearEnd} onChange={e=>setForm(f=>({...f,yearEnd:e.target.value}))}/></label><label className="text-sm sm:col-span-2">Fotos * (até 6, JPG/PNG/WebP, 8 MB cada)<Input type="file" multiple accept="image/jpeg,image/png,image/webp" onChange={e=>setFiles(Array.from(e.target.files??[]))}/><span className="text-xs text-muted-foreground">{files.length} arquivo(s) selecionado(s)</span></label></div><div className="flex justify-end gap-2"><Button variant="outline" disabled={saving} onClick={()=>setCreateOpen(false)}>Cancelar</Button><Button disabled={saving} onClick={()=>void save()}>{saving?'Salvando...':'Salvar peça'}</Button></div></div></div>}
    </>}
  </div>;
}
